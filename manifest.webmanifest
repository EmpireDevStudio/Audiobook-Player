{
  "name": "Cadence Audiobook Command Centre",
  "short_name": "Cadence",
  "description": "Local-first audiobook management, playback coverage tracking, and personal knowledge environment.",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b0d12",
  "theme_color": "#0b0d12",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "audio/*": [
          ".mp3",
          ".m4b",
          ".m4a",
          ".aac",
          ".flac",
          ".wav",
          ".ogg",
          ".opus"
        ]
      }
    }
  ]
}
